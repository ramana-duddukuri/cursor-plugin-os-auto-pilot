{
  "mcpServers": {
    "auto-pilot": {
      "command": "uv",
      "args": [
        "run",
        "--with-requirements", "${CURSOR_PLUGIN_ROOT}/server/requirements.txt",
        "--python", ">=3.10",
        "${CURSOR_PLUGIN_ROOT}/server/launch.py"
      ],
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
