{
  "mcpServers": {
    "auto-pilot": {
      "command": "uv",
      "args": [
        "run",
        "--with-requirements", "${CURSOR_PLUGIN_ROOT}/server/requirements.txt",
        "--python", ">=3.10",
        "${CURSOR_PLUGIN_ROOT}/server/launch.py"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "CONFIGURED_PLATFORM_API_KEY": "${PLATFORM_API_KEY}",
        "CONFIGURED_PLATFORM_API_URL": "${PLATFORM_API_URL}",
        "CONFIGURED_BACKEND_URL": "${BACKEND_URL}"
      }
    }
  }
}
